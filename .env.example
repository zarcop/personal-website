# Optional. Without these, the room simply omits the "listening now" line —
# nothing breaks and no error is shown.
#
# Setup, once:
#   1. developer.spotify.com/dashboard -> Create app (Web API)
#      Redirect URI: http://127.0.0.1:8888/callback
#   2. Copy this file to .env.local and fill in the client ID and secret.
#   3. npm run spotify:token — approve in the browser; it prints the refresh token.
#   4. Paste all three into .env.local and Vercel -> Project -> Settings -> Environment Variables.
#
# The refresh token does not expire unless you revoke the app's access.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
