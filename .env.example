# Optional. Without these, the room simply omits the "listening now" line —
# nothing breaks and no error is shown.
#
# Setup, once:
#   1. developer.spotify.com/dashboard -> Create app
#      Redirect URI: http://127.0.0.1:3000/callback
#   2. Authorise yourself with scope `user-read-currently-playing` and
#      `user-read-recently-played`, and exchange the code for a refresh token.
#   3. Paste all three into Vercel -> Project -> Settings -> Environment Variables.
#
# The refresh token does not expire unless you revoke the app's access.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
